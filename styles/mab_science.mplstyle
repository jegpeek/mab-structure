# mab_science.mplstyle -- matches the structure-function / shape figure of the Mab paper
# (mab-structure, src/mabsf/plotting.py: style()).
#
# Use:   import matplotlib.pyplot as plt
#        plt.style.use('mab_science.mplstyle')          # path to this file
#
# Figure size: Science double column = 7.25 in wide (single column 3.5 in).
# Panel letters: bold, 10 pt, upper left outside the axes, e.g.
#        ax.text(-0.12, 1.02, 'A', transform=ax.transAxes, fontsize=10, fontweight='bold', va='bottom')
# Colours used in the figure (Okabe-Ito, colour-blind safe):
#        windows / main data  #E69F00 (orange)     Region 1  #CC79A7 (pink)
#        Region 2             #56B4E9 (sky blue)   S2 along W  #2c6fbb (blue)
#        angle / sequential colour maps: viridis
# Font: Arial (falls back to Helvetica, then DejaVu Sans if Arial is not installed).
# On macOS, if Arial is not picked up, register it once per session:
#        from matplotlib import font_manager
#        font_manager.fontManager.addfont('/System/Library/Fonts/Supplemental/Arial.ttf')

# ---- fonts
font.family        : sans-serif
font.sans-serif    : Arial, Helvetica, DejaVu Sans
font.size          : 7
axes.labelsize     : 8
axes.titlesize     : 8
xtick.labelsize    : 7
ytick.labelsize    : 7
legend.fontsize    : 7
mathtext.fontset   : custom
mathtext.rm        : Arial
mathtext.it        : Arial:italic
mathtext.bf        : Arial:bold

# ---- figure and saving
figure.figsize     : 7.25, 4.5
figure.dpi         : 110
savefig.dpi        : 300
pdf.fonttype       : 42      # editable TrueType text in PDFs (journal requirement)
ps.fonttype        : 42
svg.fonttype       : none

# ---- axes: thin full box, no grid
axes.linewidth     : 0.6
axes.spines.top    : True
axes.spines.right  : True
axes.grid          : False
axes.labelpad      : 1.5
axes.titlepad      : 3
axes.prop_cycle    : cycler('color', ['E69F00', '56B4E9', 'CC79A7', '2c6fbb', '009E73', 'D55E00', '0072B2', 'F0E442'])
image.cmap         : viridis
image.origin       : lower

# ---- ticks: short, outward
xtick.direction    : out
ytick.direction    : out
xtick.major.size   : 2.5
ytick.major.size   : 2.5
xtick.minor.size   : 1.5
ytick.minor.size   : 1.5
xtick.major.width  : 0.6
ytick.major.width  : 0.6
xtick.minor.width  : 0.5
ytick.minor.width  : 0.5
xtick.major.pad    : 2
ytick.major.pad    : 2

# ---- lines, markers, error bars
lines.linewidth        : 0.9
lines.markersize       : 3.2
lines.markeredgewidth  : 0
errorbar.capsize       : 0

# ---- legends: no frame, compact
legend.frameon         : False
legend.handlelength    : 1.6
legend.handletextpad   : 0.4
legend.borderaxespad   : 0.3
legend.labelspacing    : 0.3
